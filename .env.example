# Copy this file to .env and configure at least ONE provider key below:

# ---------------------------------------------------------------------------
# Option A: Anthropic Claude (Production Benchmark)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Option B: Groq Cloud (Free Tier Inference)
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b

# ---------------------------------------------------------------------------
# System Paths & Configurations (Defaults shown — optional override)
# ---------------------------------------------------------------------------
DOCS_DIR=docs
TICKETS_DIR=tickets
DATA_DIR=data
TRAJECTORIES_DIR=trajectories
AGENT_REVIEW_QUEUE_DIR=agent/review_queue
CUSTOMER_CSV=data/customer_context.csv
